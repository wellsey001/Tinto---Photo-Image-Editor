{
  "name": "tinto",
  "productName": "Tinto",
  "version": "2.1.0",
  "description": "Tinto - Photo & Image Editor. A desktop photo editor for Windows and Linux with adjustments, filters, crop, text, stickers, drawing, layers and collages.",
  "homepage": "https://github.com/wellsey001/Tinto---Photo-Image-Editor",
  "main": "src/main.js",
  "desktopName": "tinto.desktop",
  "author": "Tinto contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/wellsey001/Tinto---Photo-Image-Editor.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tinto.photoeditor",
    "productName": "Tinto",
    "copyright": "Copyright © 2026 Tinto contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/**/*providers_cuda*",
      "!node_modules/onnxruntime-node/bin/**/*providers_tensorrt*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tinto",
      "artifactName": "Tinto-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "gif",
          "bmp"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "tinto"
        ],
        "name": "TintoProject",
        "description": "Tinto project",
        "role": "Editor",
        "icon": "build/icon.ico",
        "mimeType": "application/x-tinto-project"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "wellsey001",
        "repo": "Tinto---Photo-Image-Editor",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Photo & Image Editor",
      "description": "Edit photos with adjustments, filters, crop, text, stickers, drawing, layers and collages.",
      "mimeTypes": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/gif",
        "image/bmp",
        "application/x-tinto-project"
      ],
      "artifactName": "Tinto-${version}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Tinto",
          "GenericName": "Photo & Image Editor",
          "Comment": "Edit photos and make collages",
          "Keywords": "photo;image;editor;filter;crop;collage;"
        }
      },
      "syncDesktopName": true,
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/arm64/**"
      ]
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ]
  }
}
